<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@android:color/background_light">
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainFragmentFrameLayout"
    android:layout_above="@id/bottom"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardElevation="12sp"
        android:layout_marginBottom="-8sp"
        app:cardCornerRadius="12sp"
        android:id="@+id/bottom">
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:id="@+id/bottomNavigationView"
            android:layout_marginBottom="8sp"
            android:layout_alignParentBottom="true"
            app:labelVisibilityMode="labeled"
            app:itemRippleColor="@color/primary"
            app:itemTextColor="@color/bg_color_bottom_nav"
            app:itemIconTint="@color/bg_color_bottom_nav"
            app:menu="@menu/main_fragment_menu"/>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>