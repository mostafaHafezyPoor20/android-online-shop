<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="4sp">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_marginRight="48sp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardElevation="2sp"
            android:layout_margin="4sp"
            android:id="@+id/cart"
            app:cardCornerRadius="4sp"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:id="@+id/parent">
                <ImageView
                    android:layout_width="200sp"
                    android:layout_height="200sp"
                    android:id="@+id/imageProduct"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5sp"
                    android:background="@color/black"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:layout_marginTop="4sp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:layout_marginBottom="4sp"
                    android:id="@+id/product_name"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:textAlignment="center"
                    android:fontFamily="@font/vazirmatn_light"
                    android:id="@+id/product_price" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/cart"
            app:backgroundTint="@color/white"
            app:strokeWidth="1sp"
            android:fontFamily="@font/vazirmatn_bold"
            app:strokeColor="@color/black"
            android:text="مشاهده"
            android:textColor="@color/black"
            android:id="@+id/btnShowProduct"
            android:layout_alignRight="@id/cart"
            android:layout_alignLeft="@id/cart"/>
    </RelativeLayout>

</RelativeLayout>