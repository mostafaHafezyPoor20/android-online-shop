<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="4sp"
    >
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4sp"
        app:contentPadding="4sp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="150sp"
            android:background="@drawable/bg_adapter_show_product_in_group"
            android:orientation="vertical">
            <ImageView
                android:layout_width="150sp"
                android:layout_height="150sp"
                android:layout_marginTop="4sp"
                android:layout_marginRight="4sp"
                android:layout_marginBottom="4sp"
                android:layout_alignParentRight="true"
                android:scaleType="centerCrop"
                android:id="@+id/imageProduct"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:fontFamily="@font/vazirmatn_bold"
                android:textColor="@color/black"
                android:paddingRight="12sp"
                android:id="@+id/nameProduct"
                android:layout_toLeftOf="@id/imageProduct"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/red"
                android:layout_marginTop="24sp"
                android:paddingRight="12sp"
                android:id="@+id/priceProduct"
                android:fontFamily="@font/vazirmatn_light"
                android:layout_toLeftOf="@id/imageProduct"
                android:layout_below="@id/nameProduct" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>


</RelativeLayout>