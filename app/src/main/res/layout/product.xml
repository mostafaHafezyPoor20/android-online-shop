<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:adjustViewBounds="true">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:cardElevation="12sp"
        android:layout_alignParentTop="true"
        android:layoutDirection="ltr"
        android:id="@+id/toolbar">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:layout_alignParentTop="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:src="@drawable/arrow_back_24px"
                android:id="@+id/imgBack"
                android:layout_marginLeft="8sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_toRightOf="@id/imgBack"
                android:textColor="@color/black"
                android:fontFamily="@font/vazirmatn_bold"
                android:textSize="20sp"
                android:layout_toLeftOf="@id/imageShareProduct"
                android:id="@+id/productName"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/imageShareProduct"
                android:src="@drawable/share_24px"
                android:layout_alignParentRight="true"
                android:layout_marginRight="8sp"/>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/linear"
            android:layout_below="@id/toolbar">
            <androidx.viewpager.widget.ViewPager
                android:layout_width="match_parent"
                android:layout_height="350sp"
                android:id="@+id/viewPagerProductImages"/>
            <com.google.android.material.tabs.TabLayout
                android:layout_width="match_parent"
                android:layout_height="25sp"
                android:id="@+id/tabLayoutIndicator"
                app:tabGravity="center"
                app:tabIndicatorAnimationMode="elastic"
                app:tabBackground="@drawable/tab_selector"
                app:tabIndicatorHeight="0dp"
                android:layout_marginTop="-30sp"
                android:layoutDirection="ltr"
                android:background="@android:color/transparent"/>
               <com.google.android.material.tabs.TabLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   app:tabIndicatorColor="@color/primary"
                   android:id="@+id/tabLayoutMenu">
                   <com.google.android.material.tabs.TabItem
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="مشخصات محصول"
                       android:id="@+id/description_item"/>
                   <com.google.android.material.tabs.TabItem
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:id="@+id/comments_item"
                       android:text="نظرات"/>
               </com.google.android.material.tabs.TabLayout>

        </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/productFrameLayout"
        android:layout_below="@+id/linear"
        android:layout_above="@id/bottom"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:id="@+id/bottom"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="12sp"
        android:layout_marginBottom="-6sp"
        app:cardElevation="12sp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/price"
                android:gravity="center"
                android:textSize="15sp"
                android:fontFamily="@font/vazirmatn_light"
                android:layout_toLeftOf="@id/viewCenter"
                android:textColor="@color/red"/>
            <View
                android:layout_width="1sp"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:id="@+id/viewCenter"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toRightOf="@id/viewCenter"
                android:background="@color/primary"
                android:gravity="center"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:fontFamily="@font/vazirmatn_bold"
                android:id="@+id/btnAddToCart"
                android:text="افزودن به سبد خرید"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>