<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:id="@+id/shimmerLayout"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/list"
            android:layout_marginTop="4sp"
            android:orientation="vertical"
            android:paddingBottom="4sp"
            android:layout_above="@id/bottomRelativeLayout">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentLeft="true"
                    android:gravity="center"
                    android:layout_marginRight="48sp"
                    android:text="                     "
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textStyle="bold"
                    android:background="@drawable/bg_message_admin"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentRight="true"
                    android:gravity="center"
                    android:layout_marginLeft="48sp"
                    android:fontFamily="@font/vazirmatn_light"
                    android:text="              "
                    android:background="@drawable/bg_message"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentLeft="true"
                    android:gravity="center"
                    android:layout_marginRight="48sp"
                    android:text="                     "
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textStyle="bold"
                    android:background="@drawable/bg_message_admin"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentRight="true"
                    android:gravity="center"
                    android:layout_marginLeft="48sp"
                    android:fontFamily="@font/vazirmatn_light"
                    android:text="              "
                    android:background="@drawable/bg_message"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentLeft="true"
                    android:gravity="center"
                    android:layout_marginRight="48sp"
                    android:text="                     "
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textStyle="bold"
                    android:background="@drawable/bg_message_admin"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentRight="true"
                    android:gravity="center"
                    android:layout_marginLeft="48sp"
                    android:fontFamily="@font/vazirmatn_light"
                    android:text="              "
                    android:background="@drawable/bg_message"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentLeft="true"
                    android:gravity="center"
                    android:layout_marginRight="48sp"
                    android:text="                     "
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textStyle="bold"
                    android:background="@drawable/bg_message_admin"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentRight="true"
                    android:gravity="center"
                    android:layout_marginLeft="48sp"
                    android:fontFamily="@font/vazirmatn_light"
                    android:text="              "
                    android:background="@drawable/bg_message"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentLeft="true"
                    android:gravity="center"
                    android:layout_marginRight="48sp"
                    android:text="                     "
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textStyle="bold"
                    android:background="@drawable/bg_message_admin"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:padding="24sp"
                    android:layout_alignParentRight="true"
                    android:gravity="center"
                    android:layout_marginLeft="48sp"
                    android:fontFamily="@font/vazirmatn_light"
                    android:text="              "
                    android:background="@drawable/bg_message"
                    />
            </RelativeLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="70sp"
            android:visibility="gone"
            android:layout_alignParentBottom="true"
            app:cardElevation="12sp"
            android:id="@+id/bottomRelativeLayout">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="70sp"
                android:layout_gravity="bottom"
                android:elevation="20sp"
                android:background="@color/white">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cursorColor="@color/black"
                    android:layout_toLeftOf="@id/imageSend"
                    android:id="@+id/ledt"
                    android:hint="نوشتن"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:boxStrokeWidth="0sp"
                    app:boxStrokeColor="@color/white"
                    app:hintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMessage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="متن ..."
                        android:padding="10sp"
                        android:textColor="@color/black"
                        android:background="@color/white"
                        android:textColorHint="@color/gray" />
                </com.google.android.material.textfield.TextInputLayout>
                <ImageView
                    android:layout_width="40sp"
                    android:layout_height="match_parent"
                    android:src="@drawable/send_24px"
                    android:id="@+id/imageSend"
                    android:layout_marginRight="4sp"
                    app:tint="@color/gray"
                    android:rotation="180"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>
</com.facebook.shimmer.ShimmerFrameLayout>