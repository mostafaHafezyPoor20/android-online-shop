<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="4sp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="175sp"
        app:cardCornerRadius="12sp"
        app:strokeWidth="1sp"
        app:strokeColor="@color/gray">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="150sp"
                android:layout_height="match_parent"
                android:layout_alignBottom="@id/imgDelete"
                android:layout_alignParentRight="true"
               android:src="@drawable/icon"
                android:scaleType="fitXY"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/imgProduct"
                android:textAlignment="center"
                android:layout_marginTop="4sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="@font/vazirmatn_bold"
                android:id="@+id/product_name"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/product_size"
                android:layout_below="@id/product_name"
                android:layout_toLeftOf="@id/imgProduct"
                android:layout_marginTop="10sp"
                android:fontFamily="@font/vazirmatn_medium"
                android:textColor="@color/black"
                android:textAlignment="center"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/product_price"
                android:layout_below="@id/product_size"
                android:layout_toLeftOf="@id/imgProduct"
                android:layout_marginTop="10sp"
                android:fontFamily="@font/vazirmatn_medium"
                android:textColor="@color/red"
                android:textAlignment="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/product_price"
                android:layoutDirection="ltr"
                android:layout_toLeftOf="@id/imgProduct"
                android:id="@+id/linearAddOrRemove"
                android:layout_marginTop="10sp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tint="@color/black"
                    android:src="@drawable/remove_24px"
                    android:id="@+id/imgDecreazeCart"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/count"
                    android:textColor="@color/black"
                    android:textAlignment="center"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/add_24px"
                    app:tint="@color/black"
                    android:id="@+id/imgAdd"
                    android:layout_weight="1"/>
            </LinearLayout>
         <ImageView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_toLeftOf="@id/imgProduct"
             android:layout_below="@id/linearAddOrRemove"
             android:layout_marginRight="50sp"
             android:layout_marginLeft="50sp"
            android:src="@drawable/delete_24px"
             android:id="@+id/imgDelete"
             app:iconGravity="start"
             android:layout_marginTop="10sp"
             app:tint="@color/red"/>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>


</RelativeLayout>